
# WebAuthn / Passkeys (rp_id must match the UI hostname)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="${APP_NAME}"
WEBAUTHN_ORIGINS="${FRONTEND_URL}"

# Azure Blob (File Storage settings). Leave empty for local disk.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=chaacreek
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_PREFIX=

